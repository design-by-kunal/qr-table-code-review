# restaurant-management — copy to .env.local, .env.staging, or .env.uat and fill in values

SERVER_PORT=8082

# DB
DB_URL=jdbc:postgresql://<host>:5432/qr_table_order_management
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Mail
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>

# JWT
JWT_SECRET=<jwt-secret>

# AWS S3
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_KEY=<aws-secret-access-key>
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=<s3-bucket-name>

# Redis
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RabbitMQ
SPRING_RABBITMQ_HOST=<rabbitmq-host>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<rabbitmq-username>
SPRING_RABBITMQ_PASSWORD=<rabbitmq-password>

# AWS Upload API
AWS_UPLOAD_API=http://<host>/integration/api/v1/upload

# Eureka
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Customer app base URL (maps to app.base-url)
CUSTOMER_APP_BASE_URL=http://<customer-app-host>

# User Management service
USER_MANAGEMENT_BASE_URL=http://user-management:8080

# Field-level encryption master key
CRYPTO_MASTER_KEY=<crypto-master-key>

# Restaurant chain logo URLs
RESTAURANT_CHAIN_LOGO_URL=<chain-logo-url>
RESTAURANT_CHAIN_PAYMENT_METHOD_CASH_LOGO_URL=<cash-logo-url>
RESTAURANT_CHAIN_PAYMENT_METHOD_CARD_LOGO_URL=<card-logo-url>
RESTAURANT_CHAIN_PAYMENT_METHOD_UPI_LOGO_URL=<upi-logo-url>
RESTAURANT_CHAIN_PAYMENT_APP_RPAY_LOGO_URL=<rpay-logo-url>
RESTAURANT_CHAIN_PAYMENT_APP_PAYPAY_LOGO_URL=<paypay-logo-url>
RESTAURANT_CHAIN_PAYMENT_APP_PROMPTPAY_LOGO_URL=<promptpay-logo-url>
RESTAURANT_CHAIN_PAYMENT_APP_PAYNOW_LOGO_URL=<paynow-logo-url>

# Omise (chain-level keys when restaurant has no own payment account)
OMISE_PAYPAY_SECRET_KEY=<omise-paypay-secret-key>
OMISE_PAYPAY_PUBLIC_KEY=<omise-paypay-public-key>
OMISE_PAYPAY_WEBHOOK_SECRET=<omise-paypay-webhook-secret>
OMISE_PROMPTPAY_SECRET_KEY=<omise-promptpay-secret-key>
OMISE_PROMPTPAY_PUBLIC_KEY=<omise-promptpay-public-key>
OMISE_PROMPTPAY_WEBHOOK_SECRET=<omise-promptpay-webhook-secret>
OMISE_PAYNOW_SECRET_KEY=<omise-paynow-secret-key>
OMISE_PAYNOW_PUBLIC_KEY=<omise-paynow-public-key>
OMISE_PAYNOW_WEBHOOK_SECRET=<omise-paynow-webhook-secret>
OMISE_QR_API_BASE_URL=http://<api-host>/restaurant

# PayNow QR image cache (local dev)
PAYNOW_QR_STORAGE_DIR=./data/paynow-qr

# GMO QR gateway
GMO_BASE_URL=https://stg-pos-gw.gcp.gmopg.jp
GMO_LOGIN_ID=<gmo-login-id>
GMO_USER_PASSWORD=<gmo-user-password>
GMO_OS_NAME=restaurant-app
GMO_OS_VERSION=1.0.0

# GMO LinkType Plus hosted credit card (mul-pay JSON API)
GMO_LINK_PLUS_PAYMENT_URL=<gmo-link-plus-payment-url>
GMO_LINK_PLUS_SHOP_ID=<gmo-link-plus-shop-id>
GMO_LINK_PLUS_SHOP_PASS=<gmo-link-plus-shop-pass>
GMO_LINK_PLUS_CONFIG_ID=<gmo-link-plus-config-id>
GMO_LINK_PLUS_ALTER_TRAN_URL=<gmo-link-plus-alter-tran-url>
GMO_LINK_PLUS_PAYMENT_EXPIRES_MINUTES=5

# RSA encryption — public key only (private key is configured in user-management)
APP_ENCRYPTION_RSA_PUBLIC_KEY=<rsa-public-key>

# Omise webhook (required in production when OMISE_WEBHOOK_VERIFY_SIGNATURE=true)
# One signing secret per Omise account — Omise Dashboard > Settings > Webhooks
# OMISE_PAYPAY_WEBHOOK_SECRET=<paypay-account-webhook-secret>
# OMISE_PROMPTPAY_WEBHOOK_SECRET=<promptpay-account-webhook-secret>
# OMISE_PAYNOW_WEBHOOK_SECRET=<paynow-account-webhook-secret>
# OMISE_WEBHOOK_VERIFY_SIGNATURE=false

# GMO result notification URL (register in Shop Admin). HTTPS + path /api/v1/gmo/link-plus/notify
# Example local: https://<ngrok-host>/api/v1/gmo/link-plus/notify

# Swagger & Actuator (production only — disable docs, expose health for probes)
# SPRINGDOC_SWAGGER_UI_ENABLED=false
# SPRINGDOC_API_DOCS_ENABLED=false
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
