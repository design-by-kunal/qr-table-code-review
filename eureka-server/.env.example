# eureka-server — copy to .env.local, .env.staging, or .env.uat and fill in values
#
# Defaults (if unset): health+info exposed, health show-details=always
# See src/main/resources/application.properties

# Actuator (production only — expose health for Docker/K8s probes, hide details)
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never