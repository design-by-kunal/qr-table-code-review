# user-management — copy to .env.local, .env.staging, or .env.uat and fill in values

SERVER_PORT=8084

# DB
DB_URL=jdbc:postgresql://<host>:5432/qr_table_order_management
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Mail
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>

# JWT
JWT_SECRET=<jwt-secret>

# AWS S3
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_KEY=<aws-secret-access-key>
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=<s3-bucket-name>

# Redis
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RabbitMQ
SPRING_RABBITMQ_HOST=<rabbitmq-host>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<rabbitmq-username>
SPRING_RABBITMQ_PASSWORD=<rabbitmq-password>

# AWS Upload API
AWS_UPLOAD_API=http://<host>/integration/api/v1/upload

# Eureka
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# App
APP_DEFAULT_REGISTRATION_EMAIL=<registration-email>
APP_RESTAURANT_MANAGEMENT_BASE_URL=http://restaurant-management:8080

# Frontend URLs
APP_FRONTEND_URL_MANAGER=<frontend-url-manager>
APP_FRONTEND_URL_HQ_ADMIN=<frontend-url-hq-admin>
APP_FRONTEND_URL_DEFAULT=<frontend-url-default>

# RSA encryption (PEM-less base64 key material; generate per environment)
APP_ENCRYPTION_RSA_PUBLIC_KEY=<rsa-public-key>
APP_ENCRYPTION_RSA_PRIVATE_KEY=<rsa-private-key>

# Swagger & Actuator (production only — disable docs, expose health for probes)
# SPRINGDOC_SWAGGER_UI_ENABLED=false
# SPRINGDOC_API_DOCS_ENABLED=false
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
