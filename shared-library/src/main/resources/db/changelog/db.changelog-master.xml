    <!-- Original seed (kept stable for already-deployed environments) -->
    <changeSet id="insert-role-data" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="role"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM role WHERE name IN ('HQ_ADMIN','MANAGER','WAITER','CASHIER','KDS')
                </sqlCheck>
            </and>
        </preConditions>

        <sqlFile path="db/changelog/insert_role_data.sql"/>
    </changeSet>

    <!-- Safety net: if the original was MARK_RAN before role existed, insert roles now -->
    <changeSet id="2026-01-27-insert-role-data-v2" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="role"/>
        </preConditions>

        <sqlFile path="db/changelog/insert_role_data_v2.sql"/>
    </changeSet>
