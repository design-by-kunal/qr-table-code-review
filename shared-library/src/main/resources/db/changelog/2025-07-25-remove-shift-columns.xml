<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="20250725-remove-shift-columns" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="shift" columnName="weekly_off_day"/>
            <columnExists tableName="shift" columnName="number_of_days"/>
            <columnExists tableName="shift" columnName="start_date"/>
        </preConditions>

        <dropColumn tableName="shift">
            <column name="weekly_off_day"/>
        </dropColumn>
        <dropColumn tableName="shift">
            <column name="number_of_days"/>
        </dropColumn>
        <dropColumn tableName="shift">
            <column name="start_date"/>
        </dropColumn>
    </changeSet>

</databaseChangeLog> 