            <tableExists tableName="audit_trail"/>
            <columnExists tableName="audit_trail" columnName="discrepancy_reason"/>
        </preConditions>
        <dropColumn tableName="audit_trail">
            <column name="discrepancy_reason"/>
        </dropColumn>
    </changeSet>

    <!-- Drop existing action_type constraint if it exists -->
    <changeSet id="2025-12-18-drop-action-type-constraint" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="audit_trail"/>
            <columnExists tableName="audit_trail" columnName="action_type"/>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) 
                FROM information_schema.table_constraints 
                WHERE constraint_schema = current_schema()
                AND table_name = 'audit_trail'
                AND constraint_name = 'audit_trail_action_type_check'
                AND constraint_type = 'CHECK'
            </sqlCheck>
        </preConditions>
        <comment>Drop existing audit_trail action_type constraint if it exists</comment>
        <sql>
            ALTER TABLE audit_trail DROP CONSTRAINT IF EXISTS audit_trail_action_type_check;
        </sql>
    </changeSet>

    <!-- Add new action_type constraint without CASH_DRAWER_OPEN, CASH_DRAWER_CLOSE, and TRANSACTION_EDIT -->
    <changeSet id="2025-12-18-add-action-type-constraint" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="audit_trail"/>
            <columnExists tableName="audit_trail" columnName="action_type"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) 
                FROM information_schema.table_constraints 
                WHERE constraint_schema = current_schema()
                AND table_name = 'audit_trail'
                AND constraint_name = 'audit_trail_action_type_check'
                AND constraint_type = 'CHECK'
            </sqlCheck>
        </preConditions>
        <comment>
            Add audit_trail action_type constraint without CASH_DRAWER_OPEN, CASH_DRAWER_CLOSE, and TRANSACTION_EDIT enum values.
            Also normalize any legacy values (including NULL) to SYSTEM_ACTION so the constraint is not violated by existing rows.
        </comment>
        <sql>
            UPDATE audit_trail
            SET action_type = 'SYSTEM_ACTION'
            WHERE action_type IS NULL
               OR action_type::text IN ('CASH_DRAWER_OPEN', 'CASH_DRAWER_CLOSE', 'TRANSACTION_EDIT');

            ALTER TABLE audit_trail 
            ADD CONSTRAINT audit_trail_action_type_check 
            CHECK (action_type::text = ANY (ARRAY['LOGIN'::character varying::text, 'LOGOUT'::character varying::text, 'PAYMENT'::character varying::text, 'REFUND'::character varying::text, 'CANCELLATION'::character varying::text, 'DISCOUNT'::character varying::text, 'ORDER_MODIFICATION'::character varying::text, 'SYSTEM_ACTION'::character varying::text]));
        </sql>
    </changeSet>

</databaseChangeLog>

