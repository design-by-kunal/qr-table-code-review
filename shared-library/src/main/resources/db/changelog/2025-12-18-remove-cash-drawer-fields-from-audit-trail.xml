<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Drop opening_balance column -->
    <changeSet id="2025-12-18-drop-opening-balance" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="audit_trail"/>
            <columnExists tableName="audit_trail" columnName="opening_balance"/>
        </preConditions>
        <dropColumn tableName="audit_trail">
            <column name="opening_balance"/>
        </dropColumn>
    </changeSet>

    <!-- Drop closing_balance column -->
    <changeSet id="2025-12-18-drop-closing-balance" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="audit_trail"/>
