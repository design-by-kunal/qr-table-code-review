        </preConditions>
        <dropColumn tableName="audit_trail">
            <column name="closing_balance"/>
        </dropColumn>
    </changeSet>

    <!-- Drop expected_balance column -->
    <changeSet id="2025-12-18-drop-expected-balance" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="audit_trail"/>
            <columnExists tableName="audit_trail" columnName="expected_balance"/>
        </preConditions>
        <dropColumn tableName="audit_trail">
            <column name="expected_balance"/>
        </dropColumn>
    </changeSet>

    <!-- Drop discrepancy_amount column -->
    <changeSet id="2025-12-18-drop-discrepancy-amount" author="system">
