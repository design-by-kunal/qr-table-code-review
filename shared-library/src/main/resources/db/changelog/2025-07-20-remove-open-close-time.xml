<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2025-07-20-remove-open-time" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="restaurant_operating_hours" columnName="open_time"/>
        </preConditions>
        <dropColumn tableName="restaurant_operating_hours" columnName="open_time"/>
    </changeSet>

    <changeSet id="2025-07-20-remove-close-time" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="restaurant_operating_hours" columnName="close_time"/>
        </preConditions>
        <dropColumn tableName="restaurant_operating_hours" columnName="close_time"/>
    </changeSet>

</databaseChangeLog> 