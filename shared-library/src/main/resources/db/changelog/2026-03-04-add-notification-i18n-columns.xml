<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-notification-body-key-and-args" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <and>
                    <columnExists tableName="notifications" columnName="body_key"/>
                    <columnExists tableName="notifications" columnName="body_args"/>
                </and>
            </not>
        </preConditions>
        <comment>Add body_key and body_args columns to notifications table for locale-aware body resolution at read time</comment>
        <addColumn tableName="notifications">
            <column name="body_key" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="body_args" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
