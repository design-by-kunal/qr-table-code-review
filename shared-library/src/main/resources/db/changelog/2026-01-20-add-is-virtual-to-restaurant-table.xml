<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="add-is-virtual-to-restaurant-table" author="josh">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="restaurant_table" columnName="is_virtual"/>
            </not>
        </preConditions>
        
        <comment>Add is_virtual column to restaurant_table to support virtual tables.</comment>
        
        <!-- Add column with default value false -->
        <addColumn tableName="restaurant_table">
            <column name="is_virtual" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
    </changeSet>

</databaseChangeLog>
