<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="2026-05-25-add-gmo-hosted-payment-url-to-transaction" author="cursor">
    <preConditions onFail="MARK_RAN" onError="MARK_RAN">
      <and>
        <tableExists tableName="transaction"/>
        <not>
          <columnExists tableName="transaction" columnName="gmo_hosted_payment_url"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="transaction">
      <column name="gmo_hosted_payment_url" type="text"/>
      <column name="gmo_hosted_payment_link_created_at" type="timestamptz"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
