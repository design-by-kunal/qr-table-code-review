        </preConditions>
        <comment>Convert print_request.approved_at to TIMESTAMPTZ for OffsetDateTime support</comment>
        
        <sql>
            ALTER TABLE print_request
                ALTER COLUMN approved_at TYPE timestamptz
                USING approved_at AT TIME ZONE 'UTC';
        </sql>
    </changeSet>

    <!-- Convert print_request.completed_at to TIMESTAMPTZ -->
    <changeSet id="2026-01-08-3-print-request-completed-at-timestamptz" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="print_request"/>
            <columnExists tableName="print_request" columnName="completed_at"/>
        </preConditions>
        <comment>Convert print_request.completed_at to TIMESTAMPTZ for OffsetDateTime support</comment>
        
        <sql>
            ALTER TABLE print_request
                ALTER COLUMN completed_at TYPE timestamptz
                USING completed_at AT TIME ZONE 'UTC';
        </sql>
    </changeSet>

</databaseChangeLog>
