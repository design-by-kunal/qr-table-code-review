<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="remove-name-constraints" author="josh">
        <comment>Remove global unique name constraints for restaurant groups and restaurants</comment>
        
        <!-- Drop the global unique name constraints -->
        <sql>
            DROP INDEX IF EXISTS uk_restaurant_group_translation_name_ci_global;
        </sql>
        
        <sql>
            DROP INDEX IF EXISTS uk_restaurant_translation_name_ci_global;
        </sql>
        
        <!-- Keep the code constraints as they are still needed -->
        <!-- uk_restaurant_group_code_case_insensitive - KEEP -->
        <!-- uk_restaurant_code_case_insensitive - KEEP -->
        
    </changeSet>

</databaseChangeLog>
