<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2026-02-17-remove-alcohol-flag-from-item" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="item" columnName="alcohol_flag"/>
        </preConditions>
        <comment>Remove redundant alcohol_flag column from item table. Use alcohol_type enum instead.</comment>
        <dropColumn tableName="item" columnName="alcohol_flag"/>
    </changeSet>

</databaseChangeLog>
