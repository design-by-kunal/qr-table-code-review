<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2026-03-25-add-alcoholic-taxable-refund-amount" author="system">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="refund"/>
                <not>
                    <columnExists tableName="refund" columnName="alcoholic_taxable_refund_amount"/>
                </not>
            </and>
        </preConditions>

        <comment>
            Add alcoholic_taxable_refund_amount column to refund table for tax base breakdown.
        </comment>

        <addColumn tableName="refund">
            <column name="alcoholic_taxable_refund_amount" type="NUMERIC(10,2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-03-25-add-non-alcoholic-taxable-refund-amount" author="system">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="refund"/>
                <not>
                    <columnExists tableName="refund" columnName="non_alcoholic_taxable_refund_amount"/>
                </not>
            </and>
        </preConditions>

        <comment>
            Add non_alcoholic_taxable_refund_amount column to refund table for tax base breakdown.
        </comment>

        <addColumn tableName="refund">
            <column name="non_alcoholic_taxable_refund_amount" type="NUMERIC(10,2)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>

