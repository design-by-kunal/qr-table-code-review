<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2026-04-28-add-included-in-payment-to-ordered-item" author="cursor">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="ordered_item"/>
                <not>
                    <columnExists tableName="ordered_item" columnName="included_in_payment"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="ordered_item">
            <column name="included_in_payment" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2026-04-28-add-included-in-payment-to-ordered-combo" author="cursor">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="ordered_combo"/>
                <not>
                    <columnExists tableName="ordered_combo" columnName="included_in_payment"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="ordered_combo">
            <column name="included_in_payment" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>

