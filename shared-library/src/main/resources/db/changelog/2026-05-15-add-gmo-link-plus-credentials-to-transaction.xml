<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <!-- GMO LinkType Plus: AccessID/AccessPass from result notification (AlterTran RETURN at refund time) -->
  <changeSet id="2026-05-15-add-gmo-link-plus-credentials-to-transaction" author="cursor">
    <preConditions onFail="MARK_RAN" onError="MARK_RAN">
      <and>
        <tableExists tableName="transaction"/>
        <not>
          <columnExists tableName="transaction" columnName="gmo_access_id"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="transaction">
      <column name="gmo_access_id" type="varchar(64)"/>
      <column name="gmo_access_pass" type="varchar(64)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
