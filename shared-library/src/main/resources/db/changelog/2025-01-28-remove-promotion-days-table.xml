<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Drop promotion_days_of_week table -->
    <changeSet id="20250128-3-drop-promotion-days-table" author="josh">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="promotion_days_of_week"/>
        </preConditions>
        <dropTable tableName="promotion_days_of_week" cascadeConstraints="true"/>
    </changeSet>

</databaseChangeLog>
