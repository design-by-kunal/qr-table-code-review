<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2025-08-06-drop-language-id-from-restaurant-translation" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="restaurant_translation" columnName="language_id"/>
        </preConditions>
        <dropColumn tableName="restaurant_translation" columnName="language_id"/>
    </changeSet>

    <changeSet id="2025-08-06-drop-language-id-from-restaurant-group-translation" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="restaurant_group_translation" columnName="language_id"/>
        </preConditions>
        <dropColumn tableName="restaurant_group_translation" columnName="language_id"/>
    </changeSet>

</databaseChangeLog> 