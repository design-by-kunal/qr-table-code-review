<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Safe v2 changesets to add restaurant codes only when base tables exist -->

    <changeSet id="2026-01-28-add-restaurant-group-code-safe" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="restaurant_group"/>
                <not>
                    <columnExists tableName="restaurant_group" columnName="restaurant_group_code"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="restaurant_group">
            <column name="restaurant_group_code" type="VARCHAR(50)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2026-01-28-add-restaurant-code-safe" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="restaurant"/>
                <not>
                    <columnExists tableName="restaurant" columnName="restaurant_code"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="restaurant">
            <column name="restaurant_code" type="VARCHAR(50)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>

