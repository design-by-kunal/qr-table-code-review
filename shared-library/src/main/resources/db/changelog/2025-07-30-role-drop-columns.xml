<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Drop audit columns from role table -->
    <changeSet id="20250730-1-drop-role-columns" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="role" columnName="created_at"/>
            <columnExists tableName="role" columnName="updated_at"/>
            <columnExists tableName="role" columnName="created_by"/>
            <columnExists tableName="role" columnName="updated_by"/>
        </preConditions>
        <dropColumn tableName="role" columnName="created_at"/>
        <dropColumn tableName="role" columnName="updated_at"/>
        <dropColumn tableName="role" columnName="created_by"/>
        <dropColumn tableName="role" columnName="updated_by"/>
    </changeSet>

</databaseChangeLog>