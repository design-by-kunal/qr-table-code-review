<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2025-08-07-drop-dietary-preference-if-exists" author="nitesh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="item" columnName="dietary_preference"/>
        </preConditions>
        <dropColumn tableName="item" columnName="dietary_preference"/>
    </changeSet>

    <changeSet id="2025-08-07-create-dietary-preference" author="nitesh">
        <addColumn tableName="item">
            <column name="dietary_preference" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>