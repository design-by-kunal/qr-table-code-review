<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2026-01-05-backfill-expected-amount-in-cash-drawer-logs" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="cash_drawer_logs" columnName="expected_amount"/>
        </preConditions>
        
        <comment>Backfill expected_amount for historical logs where it is NULL.</comment>
        
        <update tableName="cash_drawer_logs">
            <column name="expected_amount" valueComputed="amount"/>
            <where>expected_amount IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
