<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Safe v2 changeset to add employee_count column only if restaurant table exists -->
    <changeSet id="2026-01-28-add-employee-count-safe" author="josh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="restaurant"/>
                <not>
                    <columnExists tableName="restaurant" columnName="employee_count"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="restaurant">
            <column name="employee_count" type="INTEGER">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>

