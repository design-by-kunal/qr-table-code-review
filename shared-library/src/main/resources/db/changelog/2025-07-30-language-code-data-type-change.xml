<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">


    <changeSet id="20250730-1-modify-language-code-type" author="shailesh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="users" columnName="language_code"/>
        </preConditions>
        <modifyDataType tableName="users"
                        columnName="language_code"
                        newDataType="varchar(50)"/>
    </changeSet>

    <!-- Step 3: Set default value to 'en' for future inserts -->
    <changeSet id="20250730-2-add-default-language-code" author="shailesh">
        <addDefaultValue tableName="users"
                         columnName="language_code"
                         defaultValue="en"
                         columnDataType="varchar(50)"/>
    </changeSet>

</databaseChangeLog>