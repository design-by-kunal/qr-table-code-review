<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- UPI subtype (paypay, promptpay, paynow) or CASH / CARD when payment_method has no type -->
    <changeSet id="2026-05-21-add-payment-app-to-transaction" author="cursor">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="transaction"/>
                <not>
                    <columnExists tableName="transaction" columnName="payment_app"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="transaction">
            <column name="payment_app" type="varchar(32)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
