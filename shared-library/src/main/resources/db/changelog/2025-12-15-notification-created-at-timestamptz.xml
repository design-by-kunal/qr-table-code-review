<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <!-- Change notifications.created_at to TIMESTAMPTZ and normalize existing data to UTC -->
    <changeSet id="2025-12-15-1-notifications-created-at-timestamptz" author="josh">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="notifications" columnName="created_at"/>
        </preConditions>

        <!-- Convert existing timestamp values assuming they are in UTC, and change type to timestamptz -->
        <sql>
            ALTER TABLE notifications
                ALTER COLUMN created_at TYPE timestamptz
                USING created_at AT TIME ZONE 'UTC';
        </sql>
    </changeSet>

</databaseChangeLog>


